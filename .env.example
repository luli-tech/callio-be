# Server configuration
PORT=8080
ENV=development
APP_NAME=callio-be
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=callio
MONGODB_CONNECT_TIMEOUT=3s

# SMS gateway: use "mock" locally or "jasmin" when you configure Jasmin.
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_TIMEOUT=10s
JASMIN_BASE_URL=http://localhost:1401
JASMIN_USERNAME=
JASMIN_PASSWORD=
JASMIN_DLR_URL=
